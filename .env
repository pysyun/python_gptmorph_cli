# -----------------------------------------------------------------------------
# GPT Morph processor configuration
# -----------------------------------------------------------------------------
# The active local inference node: the Tesla K80 llama.cpp server.
# These classic variables still work and map to the default processor id
# "llama_cpp" (kept for backward compatibility).
LLAMA_CPP_ENDPOINT_URI=http://192.168.0.14:8080/v1
LLAMA_CPP_MODEL=k80-model

# -----------------------------------------------------------------------------
# Multi-agent setup: many named processor instances.
#
# Define as many instances of each backend as you like, then address them by id
# when calling /generate or /patch, e.g. "/generate @k80-a,@gpt4" or
# "/generate @all" to fan a morph out across all of them in parallel.
#
# Uncomment and adapt to run several local nodes on the network at once:
#
# MRPH_PROCESSORS=k80-a,k80-b,gpt4
#
# MRPH_PROCESSOR_k80-a_TYPE=llama_cpp
# MRPH_PROCESSOR_k80-a_ENDPOINT_URI=http://192.168.0.14:8080/v1
# MRPH_PROCESSOR_k80-a_MODEL=k80-model
#
# MRPH_PROCESSOR_k80-b_TYPE=llama_cpp
# MRPH_PROCESSOR_k80-b_ENDPOINT_URI=http://192.168.0.15:8080/v1
# MRPH_PROCESSOR_k80-b_MODEL=k80-model
#
# MRPH_PROCESSOR_gpt4_TYPE=openai
# MRPH_PROCESSOR_gpt4_API_KEY=<YOUR_API_KEY>
# MRPH_PROCESSOR_gpt4_MODEL=gpt-4o
# -----------------------------------------------------------------------------
